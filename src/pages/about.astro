---
import Base from "../layouts/Base.astro";
import T from "../components/T.astro";
import { about } from "../i18n";

// Numbered index — drives both the TOC and each section's rail.
const sections = [
  { id: "ab-sec-01", num: "01", heading: about.selfBuiltHeading },
  { id: "ab-sec-02", num: "02", heading: about.careerHeading },
  { id: "ab-sec-03", num: "03", heading: about.moreHeading },
];
const mailHref = `mailto:${about.contactEmail}`;
const nn = (n: number) => String(n).padStart(2, "0");
---

<Base title="About — bbang.dev" current="about">
  <div class="about-i18n" id="about-i18n" data-lang="ko">
    <!-- ===== page heading (matches other pages) + language toggle ===== -->
    <section class="wrap">
      <div class="section-head">
        <h1>About</h1>
        <button
          class="ab-lang"
          id="lang-toggle"
          type="button"
          aria-label="Toggle language"
        >
          <span data-lang-en>KO</span><span data-lang-ko>EN</span>
        </button>
      </div>
    </section>

    <!-- ===== masthead — name + contact ===== -->
    <header class="ab-masthead">
      <div class="wrap">
        <p class="ab-name">
          <T en={about.introName.en} ko={about.introName.ko} />
        </p>
        <nav class="ab-pills" aria-label="Contact links">
          <a class="ab-pill ab-pill--cta" href={mailHref}>
            Contact <span class="ab-pill-arr" aria-hidden="true">↗</span>
          </a>
          {
            about.links.map((l) => (
              <a
                class="ab-pill"
                href={l.href}
                rel="noopener noreferrer"
                target="_blank"
              >
                {l.label}
                <span class="ab-pill-arr" aria-hidden="true">
                  ↗
                </span>
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <!-- ===== bio ===== -->
    <section class="ab-bio" aria-label="Introduction">
      <div class="wrap">
        <div class="ab-bio-card ab-rv">
          <span class="ab-bio-badge">
            <T en="About me" ko="자기소개" />
          </span>
          <div class="ab-strengths">
            {
              about.introLines.en.map((_, idx) => (
                <div class="ab-strength">
                  <span class="ab-strength-no" aria-hidden="true">
                    {nn(idx + 1)}
                  </span>
                  <h3 class="ab-strength-key">
                    <T
                      en={about.introKeys.en[idx]}
                      ko={about.introKeys.ko[idx]}
                    />
                  </h3>
                  <p class="ab-strength-body">
                    <span data-lang-en set:html={about.introLines.en[idx]} />
                    <span data-lang-ko set:html={about.introLines.ko[idx]} />
                  </p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- ===== index / table of contents ===== -->
    <nav class="ab-toc" aria-labelledby="ab-toc-title">
      <div class="wrap">
        <div class="ab-toc-head">
          <h2 class="ab-toc-title" id="ab-toc-title">
            <T en="Index" ko="목차" />
          </h2>
          <span class="label"><T en="Contents" ko="목록" /></span>
        </div>
        <ul class="ab-toc-list">
          {
            sections.map((s) => (
              <li>
                <a class="ab-toc-row" href={`#${s.id}`}>
                  <span class="ab-toc-num">{s.num}</span>
                  <span class="ab-toc-name">
                    <T en={s.heading.en} ko={s.heading.ko} />
                  </span>
                  <span class="ab-toc-leader" aria-hidden="true" />
                  <span class="ab-toc-go" aria-hidden="true">↓</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <!-- ===== 01 products — screenshot-first plates ===== -->
    <section class="ab-section" id="ab-sec-01" aria-labelledby="ab-sec-01-label">
      <div class="wrap ab-grid">
        <div class="ab-rail">
          <p class="ab-num" aria-hidden="true">01</p>
          <h2 class="ab-rail-label" id="ab-sec-01-label">
            <T en={about.selfBuiltHeading.en} ko={about.selfBuiltHeading.ko} />
          </h2>
          <hr class="ab-rail-rule" />
        </div>
        <div class="ab-body">
          {
            about.showcase.map((p, idx) => (
              <article class="ab-entry ab-rv" id={`ab-pj-${p.name}`}>
                <div class="ab-entry-top">
                  <span class="ab-entry-no">[{nn(idx + 1)}]</span>
                  <h3 class="ab-entry-title">
                    {"nameEn" in p ? (
                      <>
                        <span data-lang-ko>{p.name}</span>
                        <span data-lang-en>{p.nameEn}</span>
                      </>
                    ) : (
                      p.name
                    )}
                  </h3>
                  {p.links.length > 0 && (
                    <div class="ab-links ab-links--top">
                      {p.links.map((l) => (
                        <a
                          href={l.href}
                          rel="noopener noreferrer"
                          target="_blank"
                        >
                          {l.label} ↗
                        </a>
                      ))}
                    </div>
                  )}
                </div>
                <p class="ab-entry-meta">
                  <T en={p.role.en} ko={p.role.ko} />
                </p>

                {/* Plate — one large hero shot, thumbnails swap it in place.
                    Shots stay grayscale until hovered (or scrolled into view
                    on touch devices); todo entries render capture guides. */}
                <div class="ab-plate" data-plate>
                  <div class="ab-hero">
                    {p.shots.length > 1 && (
                      <>
                        <button
                          class="ab-nav ab-nav--prev"
                          type="button"
                          data-nav="-1"
                          aria-label="Previous screenshot"
                        >
                          ←
                        </button>
                        <button
                          class="ab-nav ab-nav--next"
                          type="button"
                          data-nav="1"
                          aria-label="Next screenshot"
                        >
                          →
                        </button>
                      </>
                    )}
                    {p.shots.map((s, k) => (
                      <figure
                        class="ab-hero-shot"
                        data-hero={k}
                        data-on={k === 0 ? "true" : "false"}
                      >
                        {"src" in s ? (
                          <>
                            {/* same src; duplicated so alt follows the
                                active language like the srcKo/En branch */}
                            <img
                              data-lang-ko
                              src={s.src}
                              alt={s.caption.ko}
                              loading="lazy"
                              decoding="async"
                            />
                            <img
                              data-lang-en
                              src={s.src}
                              alt={s.caption.en}
                              loading="lazy"
                              decoding="async"
                            />
                          </>
                        ) : (
                          <>
                            <img
                              data-lang-ko
                              src={s.srcKo}
                              alt={s.caption.ko}
                              loading="lazy"
                              decoding="async"
                            />
                            <img
                              data-lang-en
                              src={s.srcEn}
                              alt={s.caption.en}
                              loading="lazy"
                              decoding="async"
                            />
                          </>
                        )}
                        <figcaption>
                          {nn(k + 1)} —{" "}
                          <T en={s.caption.en} ko={s.caption.ko} />
                        </figcaption>
                      </figure>
                    ))}
                  </div>
                  {p.shots.length > 1 && (
                    <div class="ab-thumbs">
                      {p.shots.map((s, k) => (
                        <button
                          class="ab-thumb"
                          type="button"
                          data-thumb={k}
                          aria-current={k === 0 ? "true" : "false"}
                          aria-label={`${s.caption.ko} / ${s.caption.en}`}
                        >
                          {"src" in s ? (
                            <img src={s.src} alt="" loading="lazy" decoding="async" />
                          ) : (
                            <>
                              <img
                                data-lang-ko
                                src={s.srcKo}
                                alt=""
                                loading="lazy"
                                decoding="async"
                              />
                              <img
                                data-lang-en
                                src={s.srcEn}
                                alt=""
                                loading="lazy"
                                decoding="async"
                              />
                            </>
                          )}
                        </button>
                      ))}
                    </div>
                  )}
                </div>

                {"slogan" in p && (
                  <p class="ab-slogan">
                    <T en={p.slogan.en} ko={p.slogan.ko} />
                  </p>
                )}
                <p class="ab-entry-one">
                  <T en={p.one.en} ko={p.one.ko} />
                </p>
                {"stats" in p && (
                  <div class="ab-statchips">
                    {p.stats.map((st) => (
                      <span class="ab-statchip">
                        <b><T en={st.value.en} ko={st.value.ko} /></b>
                        <span><T en={st.label.en} ko={st.label.ko} /></span>
                      </span>
                    ))}
                  </div>
                )}

                {/* What I built — contribution | impact ledger */}
                <div class="ab-ledger">
                  <div class="ab-ledger-head">
                    <span><T en="What I built" ko="만든 것" /></span>
                    <span><T en="Impact" ko="임팩트" /></span>
                  </div>
                  {p.built.map((b, k) => (
                    <div class="ab-lrow">
                      <span class="ab-ln">{nn(k + 1)}</span>
                      <span class="ab-lt">
                        <T en={b.text.en} ko={b.text.ko} />
                        {"posts" in b &&
                          b.posts.map((href, i) => (
                            <a class="ab-postlink" href={href}>
                              <T
                                en={b.posts.length > 1 ? `post ${i + 1} ↗` : "post ↗"}
                                ko={b.posts.length > 1 ? `글 ${i + 1} ↗` : "글 ↗"}
                              />
                            </a>
                          ))}
                      </span>
                      <span class="ab-lv">
                        <T en={b.value.en} ko={b.value.ko} />
                      </span>
                    </div>
                  ))}
                </div>

                <div class="ab-tags">
                  {p.tags.map((t) => (
                    <span class="ab-chip">{t}</span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ===== 02 career ===== -->
    <section class="ab-section" id="ab-sec-02" aria-labelledby="ab-sec-02-label">
      <div class="wrap ab-grid">
        <div class="ab-rail">
          <p class="ab-num" aria-hidden="true">02</p>
          <h2 class="ab-rail-label" id="ab-sec-02-label">
            <T en={about.careerHeading.en} ko={about.careerHeading.ko} />
          </h2>
          <hr class="ab-rail-rule" />
        </div>
        <div class="ab-body">
          <ul class="ab-tl">
          {
            about.career.map((c) => (
              <li
                class={`ab-tl-item ab-rv${c.period.ko.includes("현재") ? " is-now" : ""}`}
              >
                <span class="ab-tl-dot" aria-hidden="true" />
                <div class="ab-entry-top">
                  <h3 class="ab-entry-title">
                    <a
                      class="ab-extlink"
                      href={c.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      <T en={c.company.en} ko={c.company.ko} />
                    </a>
                    {c.period.ko.includes("현재") && (
                      <span class="ab-now-badge">Now</span>
                    )}
                  </h3>
                </div>
                <p class="ab-entry-meta">
                  <T en={c.period.en} ko={c.period.ko} /> · {c.role}
                </p>
                {c.desc.ko && (
                  <p class="ab-entry-one">
                    <T en={c.desc.en} ko={c.desc.ko} />
                  </p>
                )}
                {c.points.en.length > 0 && (
                  <ul class="ab-impact">
                    {c.points.en.map((_, k) => (
                      <li>
                        <T en={c.points.en[k]} ko={c.points.ko[k]} />
                      </li>
                    ))}
                  </ul>
                )}
                {c.tags.length > 0 && (
                  <div class="ab-tags">
                    {c.tags.map((t) => (
                      <span class="ab-chip">{t}</span>
                    ))}
                  </div>
                )}
              </li>
            ))
          }
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== 03 more — activities / education / certifications ===== -->
    <section class="ab-section" id="ab-sec-03" aria-labelledby="ab-sec-03-label">
      <div class="wrap ab-grid">
        <div class="ab-rail">
          <p class="ab-num" aria-hidden="true">03</p>
          <h2 class="ab-rail-label" id="ab-sec-03-label">
            <T en={about.moreHeading.en} ko={about.moreHeading.ko} />
          </h2>
          <hr class="ab-rail-rule" />
        </div>
        <div class="ab-body">
          <div class="ab-bg">
            <p class="ab-bg-sub">
              <T
                en={about.activitiesHeading.en}
                ko={about.activitiesHeading.ko}
              />
            </p>
            {
              about.activities.map((a) => (
                <div class="ab-item">
                  <div class="ab-item-head">
                    <h3 class="ab-item-name">
                      <T en={a.title.en} ko={a.title.ko} />
                      {"links" in a &&
                        a.links.map((l) => (
                          <a
                            class="ab-postlink"
                            href={l.href}
                            target={l.href.startsWith("/") ? undefined : "_blank"}
                            rel={l.href.startsWith("/") ? undefined : "noopener noreferrer"}
                          >
                            <T en={`${l.label.en} ↗`} ko={`${l.label.ko} ↗`} />
                          </a>
                        ))}
                    </h3>
                    <span class="ab-item-when">
                      <T en={a.period.en} ko={a.period.ko} />
                    </span>
                  </div>
                  <p class="ab-item-desc">
                    <T en={a.desc.en} ko={a.desc.ko} />
                  </p>
                </div>
              ))
            }
          </div>

          <div class="ab-bg">
            <p class="ab-bg-sub">
              <T en={about.awardsHeading.en} ko={about.awardsHeading.ko} />
            </p>
            {
              about.awards.map((w) => (
                <div class="ab-item">
                  <div class="ab-item-head">
                    <h3 class="ab-item-name">
                      <T en={w.name.en} ko={w.name.ko} />
                      <a class="ab-postlink" href={w.post}>
                        <T en="post ↗" ko="글 ↗" />
                      </a>
                    </h3>
                    <span class="ab-item-when">{w.date}</span>
                  </div>
                  <p class="ab-item-desc">
                    <T en={w.desc.en} ko={w.desc.ko} />
                  </p>
                </div>
              ))
            }
          </div>

          <div class="ab-bg">
            <p class="ab-bg-sub">
              <T en={about.educationHeading.en} ko={about.educationHeading.ko} />
            </p>
            {
              about.education.map((e) => {
                const href = "href" in e ? (e.href as string) : undefined;
                return (
                  <div class="ab-item">
                    <div class="ab-item-head">
                      <h3 class="ab-item-name">
                        {href ? (
                          <a
                            class="ab-extlink"
                            href={href}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            <T en={e.school.en} ko={e.school.ko} />
                          </a>
                        ) : (
                          <T en={e.school.en} ko={e.school.ko} />
                        )}
                      </h3>
                      <span class="ab-item-when">
                        <T en={e.period.en} ko={e.period.ko} />
                      </span>
                    </div>
                    <p class="ab-item-desc">
                      <T en={e.desc.en} ko={e.desc.ko} />
                    </p>
                  </div>
                );
              })
            }
          </div>

          <div class="ab-bg">
            <p class="ab-bg-sub">
              <T en={about.certsHeading.en} ko={about.certsHeading.ko} />
            </p>
            <div class="ab-cert-chips">
              {
                about.certs.map((c) => (
                  <span class="ab-cert-chip">
                    <T en={c.name.en} ko={c.name.ko} />
                    {"post" in c && (
                      <a class="ab-postlink" href={c.post}>
                        <T en="review ↗" ko="후기 ↗" />
                      </a>
                    )}
                  </span>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== contact — inverted full-width close ===== -->
    <section class="ab-cta" aria-label="Contact">
      <div class="wrap ab-rv">
        <span class="ab-cta-label">Contact</span>
        <p class="ab-cta-title">
          <T en={about.ctaTitle.en} ko={about.ctaTitle.ko} />
        </p>
        <p class="ab-cta-sub">
          <T en={about.ctaSub.en} ko={about.ctaSub.ko} />
        </p>
        <a class="ab-cta-btn" href={mailHref}>{about.contactEmail} ↗</a>
      </div>
    </section>

    <!-- ===== sticky section spy (desktop only) ===== -->
    <nav class="ab-spy" id="ab-spy" aria-label="Section index">
      <ul>
        {
          sections.map((s) => (
            <li>
              <a href={`#${s.id}`} data-spy={s.id}>
                <span class="ab-spy-num">{s.num}</span>
                <span class="ab-spy-name">
                  <T en={s.heading.en} ko={s.heading.ko} />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <script is:inline>
    (function () {
      // Scrollspy for the fixed section index: highlight the section
      // currently nearest the top of the viewport.
      var spy = document.getElementById("ab-spy");
      if (!spy || !("IntersectionObserver" in window)) return;
      var links = spy.querySelectorAll("a[data-spy]");
      var map = {};
      links.forEach(function (a) {
        map[a.getAttribute("data-spy")] = a;
      });
      var current = null;
      function setCurrent(id) {
        if (current === id) return;
        current = id;
        links.forEach(function (a) {
          a.setAttribute(
            "aria-current",
            a.getAttribute("data-spy") === id ? "true" : "false",
          );
        });
      }
      var visible = {};
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            visible[e.target.id] = e.isIntersecting;
          });
          var ids = Object.keys(map);
          for (var i = ids.length - 1; i >= 0; i--) {
            if (visible[ids[i]]) {
              setCurrent(ids[i]);
              return;
            }
          }
          // Nothing in view (e.g. masthead/bio area) — no active marker.
          setCurrent(null);
        },
        { rootMargin: "-15% 0px -55% 0px" },
      );
      Object.keys(map).forEach(function (id) {
        var el = document.getElementById(id);
        if (el) io.observe(el);
      });
    })();
  </script>

  <script is:inline>
    (function () {
      var box = document.getElementById("about-i18n");
      var btn = document.getElementById("lang-toggle");
      if (!box) return;
      var l = "ko";
      try {
        var s = localStorage.getItem("aboutLang");
        if (s === "ko" || s === "en") l = s;
      } catch (e) {}
      box.dataset.lang = l;
      if (btn)
        btn.addEventListener("click", function () {
          var next = box.dataset.lang === "ko" ? "en" : "ko";
          box.dataset.lang = next;
          try {
            localStorage.setItem("aboutLang", next);
          } catch (e) {}
        });
    })();
  </script>

  <script is:inline>
    (function () {
      // Plate hero swap: thumbnails jump, arrows cycle; both share show().
      document.querySelectorAll("[data-plate]").forEach(function (plate) {
        var heroes = plate.querySelectorAll("[data-hero]");
        var thumbs = plate.querySelectorAll("[data-thumb]");
        var cur = 0;
        function show(k) {
          cur = ((k % heroes.length) + heroes.length) % heroes.length;
          heroes.forEach(function (h) {
            h.setAttribute(
              "data-on",
              h.getAttribute("data-hero") === String(cur) ? "true" : "false",
            );
          });
          thumbs.forEach(function (x) {
            x.setAttribute(
              "aria-current",
              x.getAttribute("data-thumb") === String(cur) ? "true" : "false",
            );
          });
        }
        thumbs.forEach(function (t) {
          t.addEventListener("click", function () {
            show(parseInt(t.getAttribute("data-thumb"), 10));
          });
        });
        plate.querySelectorAll("[data-nav]").forEach(function (b) {
          b.addEventListener("click", function () {
            show(cur + parseInt(b.getAttribute("data-nav"), 10));
          });
        });
      });
    })();
  </script>

  <script is:inline>
    (function () {
      // Scroll reveal. The rv-ready class arms the initial hidden state so
      // content stays visible when JS never runs; is-in also recolors plate
      // shots on touch devices (no hover).
      var box = document.getElementById("about-i18n");
      var els = document.querySelectorAll(".ab-rv");
      if (!box || !els.length || !("IntersectionObserver" in window)) return;
      box.classList.add("rv-ready");
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add("is-in");
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 },
      );
      els.forEach(function (el) {
        io.observe(el);
      });
    })();
  </script>

</Base>
